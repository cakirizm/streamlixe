<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StreamLiveX</AssemblyName>
    <RootNamespace>StreamLiveX.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!-- VideoLAN.LibVLC.Windows 3.0.23.1 NuGet paketi, AC3/E-AC3 sesini paketlemek için gereken
       libpacketizer_a52 eklentisini içermiyor. Bu yüzden AC3 sesli film/dizilerde ses gelmiyordu
       (canlı TV AAC olduğu için çalışıyordu). Aynı sürümlü (3.0.23, ABI-uyumlu) VLC kurulumundan
       alınan eksik ses eklentilerini vlc-plugins/ altında repoda tutup her derlemede libvlc plugin
       klasörüne kopyalıyoruz; böylece Store paketi dahil her yapıda ses çalışıyor. -->
  <ItemGroup>
    <Content Include="vlc-plugins\**\*.dll" Link="libvlc\win-x64\plugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
