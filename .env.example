# TMDB v3 API anahtarı veya v4 Read Access Token
TMDB_TOKEN=BURAYA_TMDB_ANAHTARINIZI_YAZIN

# OpenSubtitles.com REST API anahtarı (altyazı arama/indirme)
OPENSUBTITLES_API_KEY=BURAYA_OPENSUBTITLES_ANAHTARINIZI_YAZIN

# API-Sports / API-Football anahtarı. Yalnız sunucuda tutulur; Android APK'ya gömülmez.
# Anahtar yoksa Sports Hub TheSportsDB ücretsiz fallback'iyle çalışmaya devam eder.
API_FOOTBALL_KEY=BURAYA_API_FOOTBALL_ANAHTARINIZI_YAZIN

# football-data.org v4 anahtarı. Yalnız server-side kullanılır, Android APK'ya gönderilmez.
FOOTBALL_DATA_KEY=BURAYA_FOOTBALL_DATA_ANAHTARINIZI_YAZIN

# İsteğe bağlı API kökü. Yerel geliştirmede boş bırakın; Docker Compose bunu otomatik ayarlar.
# TMDB_API_BASE_URL=https://api.themoviedb.org

# İsteğe bağlı
NODE_ENV=development
